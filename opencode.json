{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./plugin"],
  "providers": {
    "LocalAI": {
      "name": "Local Host",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.0.124:8080/v1",
        "apiKey": "sk-LocalAPI_Key"
      },
      "models": {
        "Qwen3-Coder": {
          "name": "Qwen3-Coder",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
